{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "~/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "packages",
    "types",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ios",
    "android",
    ".expo"
  ]
}