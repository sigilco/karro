# Karro iOS delivery lanes.
#
# Signing model: xcodebuild "Automatically manage signing" + the App Store
# Connect API key (-allowProvisioningUpdates + -authenticationKey* flags).
# No match, no certificate repo — see fastlane/DEPLOY.md for the rationale.

require "base64"

APP_IDENTIFIER = "com.sigilco.karro"
XCODEPROJ = "ios/karro.xcodeproj"
SCHEME = "karro"

default_platform(:ios)

platform :ios do
  desc "Archive a Release build and upload the IPA to TestFlight"
  lane :beta do
    setup_ci # temp keychain + CI-safe defaults
    api_key = asc_api_key

    build_number = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER) + 1
    rescue => e
      UI.important("latest_testflight_build_number failed (#{e.message}); starting at 1")
      1
    end
    increment_build_number_in_plist(
      build_number: build_number,
      xcodeproj: XCODEPROJ,
      scheme: SCHEME,
      target: SCHEME
    )

    auth_xcargs = [
      "-allowProvisioningUpdates",
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')}"
    ].join(" ")

    gym(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "karro",
      xcargs: auth_xcargs,
      export_xcargs: auth_xcargs,
      export_options: {
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingStyle: "automatic"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: Actions.lane_context[Actions::SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end

  desc "One-time: create the App Store Connect app record + register the App ID"
  lane :register do
    produce(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_name: "Karro",
      app_version: "0.1.0",
      sku: "karro",
      language: "English",
      platform: "ios"
    )
  end

  desc "Build an unsigned .xcarchive only — sanity check for CI debugging"
  lane :archive do
    setup_ci
    gym(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      skip_codesigning: true,
      output_directory: "build",
      output_name: "karro"
    )
  end

  private_lane :asc_api_key do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    p8_b64 = ENV.fetch("ASC_KEY_P8")

    # xcodebuild needs the .p8 as a file; fastlane actions take it inline.
    key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(p8_b64))
    File.chmod(0o600, key_path)
    ENV["ASC_KEY_PATH"] = key_path

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: p8_b64,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end
end
